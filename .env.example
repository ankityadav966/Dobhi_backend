# ============================================================================
# DOCKER POSTGRESQL & PGADMIN CONFIGURATION
# ============================================================================
POSTGRES_DB=dobhi_db
POSTGRES_USER=dobhi_user
POSTGRES_PASSWORD=dobhi_secure_password_2026
POSTGRES_PORT=5432

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dobhi_db
DB_USER=dobhi_user
DB_PASSWORD=dobhi_secure_password_2026

PGADMIN_DEFAULT_EMAIL=admin@dobhi.com
PGADMIN_DEFAULT_PASSWORD=dobhi_admin_secret_2026
PGADMIN_PORT=5050

# Database URL for Prisma (Scenario A: Localhost -> Docker PostgreSQL)
DATABASE_URL="postgresql://dobhi_user:dobhi_secure_password_2026@localhost:5432/dobhi_db?schema=public"

# Database URL for Prisma (Scenario B: Backend inside Docker container)
# DATABASE_URL="postgresql://dobhi_user:dobhi_secure_password_2026@postgres:5432/dobhi_db?schema=public"

# ============ JWT ============
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

# ============ REDIS ============
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ============ RAZORPAY PAYMENT INTEGRATION ============
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAYX_ACCOUNT_NUMBER=2323230041626905
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ============ OTP CONFIGURATION ============
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
OTP_EXPIRE=600
OTP_PROVIDER=twilio

# ============ SMTP EMAIL CONFIGURATION ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="GROCERYLAUNDRY Partner <your_email@gmail.com>"

# ============ SERVER ============
PORT=5001
NODE_ENV=development
